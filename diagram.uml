@startuml
package "crud-pipeline-app" {
    package "CRUD" {
        node "frontend(react app + Nginx)" as frontend
        node "auth-service" as auth
        node "products-service" as products
        node "db_auth" as db_auth
        node "db_products" as db_products
    }
    package "Data pipeline" {
        node "scraper-service" as scraper
        node "transformer-service" as transformer
        node "orchestrator-service" as orchestrator
        node "mongo_db" as mongo
    }

    package "Docker Compose" {
        artifact "docker-compose.yml" as compose
    }

    cloud "internet" as internet

    internet --> frontend :  HTTP
    frontend --> auth : HTTP\n/auth/signup, /auth/login\n(JWT)
    frontend --> products : HTTP\n/api/products\n(JWT)
    frontend --> orchestrator : HTTP\n/orchestrate/{category}?q=...
    
    auth --> db_auth : PostgreSQL
    products --> db_products : PostgreSQL

    orchestrator --> scraper : HTTP(start scraping) \n /scrape/{category}/?q=...
    orchestrator --> transformer : HTTP(trigger transformation) \n /transform/{category}

    scraper --> mongo : MongoDB (save Immutable Data)
    transformer --> mongo  : MongoDB (read Data)
    transformer --> db_products : PostgreSQL (save cleaned Data)

}

@enduml
